# Copie para .env (no servidor da Evolution). NUNCA envie o .env para o Git.

# Domínio público com HTTPS (o DNS precisa apontar para este servidor)
EVOLUTION_DOMAIN=evolution.suaempresa.com.br

# Chave global da API. A MESMA vai para EVOLUTION_API_KEY no servidor do Tropi.
# Gere com: openssl rand -hex 32
AUTHENTICATION_API_KEY=

# Senha do banco da Evolution. Gere com: openssl rand -hex 24
POSTGRES_PASSWORD=

# Cloud API via Evolution: token que você digita no painel da Meta ao cadastrar o webhook
# https://<EVOLUTION_DOMAIN>/webhook/meta . Gere com: openssl rand -hex 16
WA_BUSINESS_TOKEN_WEBHOOK=
