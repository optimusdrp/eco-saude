# Copie este arquivo para ".env" na raiz e ajuste os valores.
# NUNCA envie o arquivo .env para o Git.

# Conexão com o PostgreSQL (o docker-compose usa estes valores)
DATABASE_URL=postgres://postgres:postgres@localhost:54320/ecosaude

# Chave para criptografar os segredos de 2FA no banco (32 bytes em base64).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOTP_ENCRYPTION_KEY=

# Senha do primeiro administrador criado pelo seed (troque após o primeiro login)
SEED_ADMIN_EMAIL=admin@ecosaude.local
SEED_ADMIN_PASSWORD=

# ------------------------------- CRM (apps/app) -------------------------------
# Rotina agendada (Vercel Cron): a Vercel envia "Authorization: Bearer <CRON_SECRET>".
# Gere com: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=

# LGPD: segredo do código que identifica quem pediu exclusão sem guardar o telefone.
# Gere com: openssl rand -hex 32  (NUNCA troque depois de usar: os códigos antigos param de bater)
LGPD_HASH_SECRET=

# Canais. Deixe VAZIO para usar só a SIMULAÇÃO (padrão).
# Os IDs de conta (número, página, bot) de cada clínica ficam em Ajustes > Canais;
# aqui ficam só os SEGREDOS do app da EcoSaúde.
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v23.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
MESSENGER_PAGE_TOKEN=
MESSENGER_PAGE_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# ------------------------------ IA (Gemini) ------------------------------
# Rascunho de resposta nas conversas (Ajustes > Automações > Inteligência artificial).
# Sem chave, o CRM usa só o PLANO B (sugestões por regras), sem enviar dados para fora.
# LGPD: use uma conta PAGA do Gemini API (ou Vertex AI) com termo de tratamento de dados;
# no nível gratuito o Google pode usar os dados para melhorar os produtos.
GEMINI_API_KEY=
# Confirme que a chave é de um projeto COM FATURAMENTO ATIVO (nível pago). Sem "sim", a IA
# fica desligada (plano B), mesmo com a chave: nenhum dado de paciente vai para a conta gratuita.
GEMINI_PAID_TIER=
# Modelo principal e o reserva (usado quando o principal falha ou está sem cota)
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Modelo para classificar a intenção das mensagens (leve e barato; o principal fica de reserva)
GEMINI_CLASSIFY_MODEL=gemini-3.5-flash-lite
# Tempo máximo por tentativa (ms). Passou disso, vai para o reserva e depois para o plano B.
AI_TIMEOUT_MS=9000
# gemini (padrão) | mock (testes sem internet; AI_MOCK_MODE=ok|fail|slow|clinical|bad)
AI_PROVIDER=gemini

# Previsão de chuva para o risco de falta (Open-Meteo: gratuita, sem chave, só a cidade da clínica)
# open-meteo (padrão) | mock (testes sem internet) | off (desliga; o modelo segue sem chuva)
WEATHER_PROVIDER=open-meteo

# ---------------------------- Anexos das conversas ----------------------------
# Fotos de exame, PDFs, áudios: dado de saúde. Sempre PRIVADO (nenhum link público).
# local = pasta no servidor (só desenvolvimento; na Vercel o disco é temporário)
# s3    = AWS S3 (produção). Sem STORAGE_DRIVER em produção, os anexos ficam desligados.
STORAGE_DRIVER=local
# STORAGE_LOCAL_DIR=           # padrão: apps/app/.data/anexos
# Produção (S3): bucket PRIVADO, de preferência em São Paulo (dados no Brasil)
# S3_BUCKET=
# S3_REGION=sa-east-1
# S3_KMS_KEY_ID=               # opcional: chave KMS própria (sem ela, criptografia AES-256 da AWS)
# AWS_ACCESS_KEY_ID=           # ou papel IAM; permissões mínimas: s3:PutObject, s3:GetObject, s3:DeleteObject no bucket
# AWS_SECRET_ACCESS_KEY=

# ------------------------- E-mail (recuperação de senha) -------------------------
# Só e-mails da conta (link de nova senha e aviso de senha alterada); nunca dado de paciente.
# ses = Amazon SES (recomendado) | resend = Resend | arquivo = só desenvolvimento (grava em apps/app/.data/emails)
# Sem EMAIL_DRIVER em produção, a recuperação por e-mail fica desligada (a gestão redefine a senha).
EMAIL_DRIVER=arquivo
# Reserva: usado quando o principal falha (ex.: principal ses, reserva resend)
EMAIL_FALLBACK=
EMAIL_FROM="EcoSaúde <nao-responda@seudominio.com.br>"
# Endereço público do CRM para os links dos e-mails (https em produção). NUNCA é lido da requisição.
APP_URL=http://localhost:3002
# SES_REGION=sa-east-1         # credenciais: as mesmas variáveis AWS_* do S3 (permissão ses:SendEmail)
# SES_CONFIGURATION_SET=       # opcional: para acompanhar entregas e devoluções no SES
# RESEND_API_KEY=
